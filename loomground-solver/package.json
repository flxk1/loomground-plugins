{
  "$schema": "../schemas/loomground-package.schema.json",
  "schemaVersion": 1,
  "name": "loomground-solver",
  "version": "0.2.0",
  "description": "The Solver plugin — the universal reasoning kernel exposed as skills, in two lobes. Deductive/rule: extract deontic norms, compile them to Loomground .lg grammar, reason cases to a justified PASS/VIOLATION/ESCALATE verdict, resolve rule conflicts. Analytic/probabilistic: model opponents, track probabilities, analyse strategy, estimate liability, assess litigation risk, analyse risks. Thin wrappers over the installed loomground_solver; never a copied reasoner.",
  "author": {
    "name": "flxk1"
  },
  "keywords": [
    "solver",
    "governance",
    "rule-reasoning",
    "deontic",
    "decision-theory",
    "bayesian",
    "loomground",
    "policy"
  ],
  "skills": [
    {
      "name": "extract-policy-norms",
      "path": "skills/extract-policy-norms",
      "provides": [
        "governance.extract-norms"
      ]
    },
    {
      "name": "compile-loomground-policy",
      "path": "skills/compile-loomground-policy",
      "provides": [
        "governance.compile-policy"
      ]
    },
    {
      "name": "reason-governance-rules",
      "path": "skills/reason-governance-rules",
      "provides": [
        "governance.reason"
      ]
    },
    {
      "name": "resolve-rule-conflicts",
      "path": "skills/resolve-rule-conflicts",
      "provides": [
        "governance.resolve-conflicts"
      ]
    },
    {
      "name": "opponent-modeler",
      "path": "skills/opponent-modeler",
      "provides": [
        "solver.opponent-model"
      ]
    },
    {
      "name": "probability-tracker",
      "path": "skills/probability-tracker",
      "provides": [
        "solver.probability-track"
      ]
    },
    {
      "name": "strategic-analysis",
      "path": "skills/strategic-analysis",
      "provides": [
        "solver.strategic-analysis"
      ]
    },
    {
      "name": "estimate-liability",
      "path": "skills/estimate-liability",
      "provides": [
        "solver.liability-estimate"
      ]
    },
    {
      "name": "litigation-risk-assessor",
      "path": "skills/litigation-risk-assessor",
      "provides": [
        "solver.litigation-risk"
      ]
    },
    {
      "name": "analyse-risks",
      "path": "skills/analyse-risks",
      "provides": [
        "solver.risk-analysis"
      ]
    }
  ],
  "capabilities": {
    "governance.extract-norms": {
      "mode": "read",
      "humanConfirmation": false
    },
    "governance.compile-policy": {
      "mode": "read-write",
      "humanConfirmation": true
    },
    "governance.reason": {
      "mode": "read",
      "humanConfirmation": false
    },
    "governance.resolve-conflicts": {
      "mode": "read",
      "humanConfirmation": false
    },
    "solver.opponent-model": {
      "mode": "read",
      "humanConfirmation": false
    },
    "solver.probability-track": {
      "mode": "read",
      "humanConfirmation": false
    },
    "solver.strategic-analysis": {
      "mode": "read",
      "humanConfirmation": false
    },
    "solver.liability-estimate": {
      "mode": "read",
      "humanConfirmation": false
    },
    "solver.litigation-risk": {
      "mode": "read",
      "humanConfirmation": false
    },
    "solver.risk-analysis": {
      "mode": "read",
      "humanConfirmation": false
    }
  },
  "runtime": {
    "python": ">=3.10",
    "network": false,
    "config": [],
    "requires": [
      "loomground_solver"
    ]
  },
  "adapters": {
    "claude": {},
    "codex": {
      "interface": {
        "displayName": "Loomground Solver",
        "shortDescription": "Governance rule-reasoning and analytic decision reasoning over the Loomground Solver",
        "longDescription": "Two lobes over one kernel: turn policy into runnable Loomground grammar and reason cases to a justified, replayable verdict with a bounded decision space; and reason under uncertainty — opponents, probabilities, strategy, liability, litigation and risk — with a named method behind every result. Wraps the installed loomground_solver; writes and authoritative policies are human-confirmed.",
        "developerName": "Flxk1",
        "category": "Productivity",
        "capabilities": [
          "Governance rule-reasoning",
          "Deontic norms",
          "Decision theory",
          "Bayesian estimation",
          "Replayable verdicts",
          "Local-first"
        ],
        "defaultPrompt": [
          "Extract the rules from this regulation.",
          "Is this action compliant with the policy?",
          "Which rule wins when these two conflict?",
          "What's my best move here?",
          "How likely is liability given these facts?"
        ]
      }
    },
    "generic": {}
  }
}
