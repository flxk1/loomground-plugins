{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomground.dev/schemas/enforcement-receipt.schema.json",
  "title": "Loomground enforcement receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "intentId",
    "inputDigest",
    "policyDigest",
    "decision",
    "adapter",
    "issuedAt",
    "expiresAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": {"const": "loomground.enforcement-receipt/1"},
    "decisionId": {"type": "string", "minLength": 1},
    "intentId": {"type": "string", "minLength": 1},
    "inputDigest": {"$ref": "#/$defs/sha256"},
    "policyDigest": {"$ref": "#/$defs/sha256"},
    "decision": {
      "enum": ["permit", "hold", "deny", "route-human"]
    },
    "adapter": {"type": "string", "minLength": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "singleUse": {"const": true},
    "effectReceipt": {"type": "object"},
    "evidenceRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "value"],
      "properties": {
        "keyId": {"type": "string", "minLength": 1},
        "algorithm": {"const": "Ed25519"},
        "value": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
